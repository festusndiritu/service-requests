# PostgreSQL. On Neon use the pooled URL for DATABASE_URL and the direct URL for DIRECT_URL.
# For a local database both are the same URL.
DATABASE_URL="postgresql://user:password@host-pooler.neon.tech/db?sslmode=require"
DIRECT_URL="postgresql://user:password@host.neon.tech/db?sslmode=require"

# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=""

PORT=3000
NODE_ENV=development

# Cloudflare R2 photo storage. Optional: without these, photo upload returns an error
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
# Only if the bucket was created with a jurisdiction ("eu" or "fedramp"); leave empty otherwise
R2_JURISDICTION=""

# TiaraConnect SMS for password reset codes. Use a sender ID approved on your account.
# With TIARA_API_KEY empty (development only) the code is printed in the API console instead.
TIARA_API_KEY=""
TIARA_SENDER_ID="TIARA"
# Optional override, default https://api2.tiaraconnect.io
TIARA_BASE_URL=""

# Used by `npm run db:seed` to create the first administrator
ADMIN_EMAIL="admin@murangacounty.example"
ADMIN_ID_NUMBER="00000001"
ADMIN_PASSWORD=""
